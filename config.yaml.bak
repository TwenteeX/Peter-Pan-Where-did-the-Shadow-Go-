project:
  name: Peter Pan, Where did the Shadow Go?
  version: 0.1.0
perception:
  camera_index: 0
  image_width: 1280
  image_height: 720
  shadow:
    method: detector_sam2
    threshold: 30
    min_area: 100.0
    detector:
      model: yolov8n.pt
      min_conf: 0.25
      max_objects: 10
    tracker:
      enabled: true
      backend: bytetrack
      bytetrack_cfg: bytetrack.yaml
      iou_threshold: 0.25
      center_dist_px: 120.0
      max_age_frames: 20
    sam2:
      device: cuda
      model_cfg: C:/Users/james/miniconda3/envs/shadowpan/Lib/site-packages/sam2/configs/sam2.1/sam2.1_hiera_l.yaml
      checkpoint: C:/Users/james/Desktop/Peter-Pan-Where-did-the-Shadow-Go-/peter_pan/config/sam2.1_hiera_large.pt
      run_each_frame: false
      max_objects_per_sam_pass: 10
  vlm:
    provider: openai
    enabled: true
    trigger_mode: manual
    interval_sec: 3.0
    only_when_object_visible: true
    use_largest_contour_crop: true
    max_image_side: 1024
    max_tokens: 200
    max_objects_per_batch: 10
    model: gpt-4o-mini
    prompt: Identify the object in this image and describe its key living attributes
      in one short phrase (e.g. a small white cat).
world_engine:
  use_depth: false
  voxel_size: 0.01
  plane_space:
    follow_detection: false
    nudge_step: 0.02
    physical_extent_cm:
    - 60.0
    - 40.0
    homography:
      enabled: true
      image_points:
      - - 118.0
        - 57.0
      - - 1142.0
        - 79.0
      - - 1153.0
        - 620.0
      - - 98.0
        - 623.0
      plane_points:
      - - 0.0
        - 0.0
      - - 1.0
        - 0.0
      - - 1.0
        - 1.0
      - - 0.0
        - 1.0
agent_brain:
  provider: openai
  model: gpt-4o-mini
  interval_sec: 3.0
  max_image_side: 512
  max_tokens: 300
  system_prompt: '你是一個影子角色，活在一個 {w}x{h} cm 的平面空間裡。

    你的位置以 (offset_x_cm, offset_y_cm) 表示，原點在擷取時的位置。

    正 x = 右，正 y = 下。

    根據照片裡的物體與環境，決定你下一步要怎麼移動與表演。

    action 必須是 idle, walk, hop, stretch, hide, climb, inspect, flee 其中之一。

    只回覆一個 JSON 物件（不要 markdown）：

    {{"action": "walk", "dx_cm": float, "dy_cm": float, "duration_sec": float, "reason":
    "簡短說明"}}

    '
render_bridge:
  transport: osc
  osc:
    host: 127.0.0.1
    port: 7000
  websocket:
    url: ws://127.0.0.1:8765
